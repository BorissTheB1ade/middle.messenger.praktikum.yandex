<header class="header-area">
    {{{logoutButton}}}
</header>
<div class="chat-container">
    <div class="chat-list-container">
        <div class="go-to-profile">
            {{{goToProfileLink}}}
            <img alt="goToProfileIcon" src="icons/caret_right.svg"/>
        </div>
        {{{chatSearch}}}
        {{{chatList}}}
    </div>
    <div class="chat-area-container">
        <div class="message-area-and-header">
        {{{chatHeader}}}
        {{{messageArea}}}
        </div>
        <div class="message-input-area">
            {{{messageInput}}}
        </div>
    </div>
</div>
